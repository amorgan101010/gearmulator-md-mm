				</div>
			</td>
			<td class="settings-td">
				<div id="btPadTouchXTarget12" class="settings-checkboxwithlabel">
					<button id="button" class="settings-checkbox"/>
					<label>C</label>
				</div>
			</td>
			<td class="settings-td">
				<div id="btPadTouchXTarget13" class="settings-checkboxwithlabel">
					<button id="button" class="settings-checkbox"/>
					<label>D</label>
				</div>
			</td>
			<td class="settings-td">
				<div id="btPadTouchXTarget14" class="settings-checkboxwithlabel">
					<button id="button" class="settings-checkbox"/>
					<label>E</label>
				</div>
			</td>
			<td class="settings-td">
				<div id="btPadTouchXTarget15" class="settings-checkboxwithlabel">
					<button id="button" class="settings-checkbox"/>
					<label>F</label>
				</div>
			</td>
			<td class="settings-td">
				<div id="btPadTouchXTarget16" class="settings-checkboxwithlabel">
					<button id="button" class="settings-checkbox"/>
					<label>G</label>
				</div>
			</td>
			<td class="settings-td">
				<div id="btPadTouchXTarget17" class="settings-checkboxwithlabel">
					<button id="button" class="settings-checkbox"/>
