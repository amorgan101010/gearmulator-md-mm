				</div>
			</td>
		</tr>
		<tr class="settings-tr">
			<td class="settings-td">
				<div id="btPadTouchXSpeed25" class="settings-checkboxwithlabel">
					<button id="button" class="settings-checkbox"/>
					<label>25%</label>
				</div>
			</td>
			<td class="settings-td">
				<div id="btPadTouchXSpeed50" class="settings-checkboxwithlabel">
					<button id="button" class="settings-checkbox"/>
					<label>50%</label>
				</div>
			</td>
			<td class="settings-td">
				<div id="btPadTouchXSpeed100" class="settings-checkboxwithlabel">
					<button id="button" class="settings-checkbox"/>
					<label>100%</label>
				</div>
			</td>
			<td class="settings-td">
				<div id="btPadTouchXSpeed200" class="settings-checkboxwithlabel">
					<button id="button" class="settings-checkbox"/>
					<label>200%</label>
				</div>
			</td>
			<td class="settings-td">
				<div id="btPadTouchXSpeed400" class="settings-checkboxwithlabel">
					<button id="button" class="settings-checkbox"/>
					<label>400%</label>
				</div>
			</td>
		</tr>
	</table>
	<settingsspacer1/>
