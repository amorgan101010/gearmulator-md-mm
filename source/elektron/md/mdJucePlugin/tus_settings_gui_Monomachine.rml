				</div>
			</td>
			<td class="settings-td">
				<div id="btPadTiltRollTarget15" class="settings-checkboxwithlabel">
					<button id="button" class="settings-checkbox"/>
					<label>F</label>
				</div>
			</td>
			<td class="settings-td">
				<div id="btPadTiltRollTarget16" class="settings-checkboxwithlabel">
