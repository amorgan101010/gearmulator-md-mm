					<button id="button" class="settings-checkbox"/>
					<label>D</label>
				</div>
			</td>
			<td class="settings-td">
				<div id="btPadTiltPitchTarget14" class="settings-checkboxwithlabel">
					<button id="button" class="settings-checkbox"/>
					<label>E</label>
				</div>
			</td>
			<td class="settings-td">
				<div id="btPadTiltPitchTarget15" class="settings-checkboxwithlabel">
					<button id="button" class="settings-checkbox"/>
					<label>F</label>
				</div>
			</td>
			<td class="settings-td">
