					<label>A</label>
				</div>
			</td>
			<td class="settings-td">
				<div id="btPadTiltPitchTarget11" class="settings-checkboxwithlabel">
					<button id="button" class="settings-checkbox"/>
					<label>B</label>
				</div>
			</td>
			<td class="settings-td">
				<div id="btPadTiltPitchTarget12" class="settings-checkboxwithlabel">
