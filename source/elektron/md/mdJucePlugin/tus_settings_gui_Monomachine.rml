			</td>
			<td class="settings-td">
				<div id="btPadTiltPitchSpeed100" class="settings-checkboxwithlabel">
					<button id="button" class="settings-checkbox"/>
					<label>100%</label>
				</div>
			</td>
			<td class="settings-td">
