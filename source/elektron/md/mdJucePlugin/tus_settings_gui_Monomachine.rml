	</table>
	<div id="btPadTiltPitchFunction" class="settings-checkboxwithlabel">
		<button id="button" class="settings-checkbox"/>
		<label>Hold FUNCTION while turning (Machinedrum: changes that parameter on every track)</label>
	</div>
	<div id="btPadTiltPitchAbsolute" class="settings-checkboxwithlabel">
		<button id="button" class="settings-checkbox"/>
		<label>Absolute position (touchpad corner or tilt angle = knob value)</label>
	</div>
	<div id="btPadTiltPitchInvert" class="settings-checkboxwithlabel">
		<button id="button" class="settings-checkbox"/>
		<label>Invert direction</label>
	</div>
	<label>Speed (for tilt in absolute mode: how far to tilt)</label>
	<table class="settings-table">
		<tr class="settings-tr">
			<td class="settings-td">
				<div id="btPadTiltPitchSpeed25" class="settings-checkboxwithlabel">
					<button id="button" class="settings-checkbox"/>
