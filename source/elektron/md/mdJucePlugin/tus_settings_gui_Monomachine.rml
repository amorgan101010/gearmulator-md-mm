				</div>
			</td>
			<td class="settings-td">
				<div id="btPadTiltRollTarget99" class="settings-checkboxwithlabel">
					<button id="button" class="settings-checkbox"/>
					<label>Off</label>
				</div>
			</td>
		</tr>
		<tr class="settings-tr">
			<td class="settings-td">
				<div id="btPadTiltRollTarget10" class="settings-checkboxwithlabel">
					<button id="button" class="settings-checkbox"/>
					<label>A</label>
				</div>
			</td>
			<td class="settings-td">
				<div id="btPadTiltRollTarget11" class="settings-checkboxwithlabel">
					<button id="button" class="settings-checkbox"/>
					<label>B</label>
				</div>
			</td>
			<td class="settings-td">
				<div id="btPadTiltRollTarget12" class="settings-checkboxwithlabel">
