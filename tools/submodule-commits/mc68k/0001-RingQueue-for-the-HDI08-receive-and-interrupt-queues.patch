diff --git a/ringQueue.h b/ringQueue.h
new file mode 100644
index 0000000..1cdbf24
--- /dev/null
+++ b/ringQueue.h
@@ -0,0 +1,84 @@
+#pragma once
+
+#include <cassert>
+#include <cstddef>
+#include <vector>
+
+namespace mc68k
+{
+	// A FIFO for the emulated buses' word and vector queues. Unlike std::deque, which allocates and
+	// frees a block every time its front or back crosses a block boundary (even at a constant
+	// depth), its storage only grows, by doubling, when the queue is deeper than it has ever been.
+	// A queue that stays within its high-water mark never touches the heap, so it is safe on the
+	// audio thread once warm.
+	template<typename T>
+	class RingQueue
+	{
+	public:
+		explicit RingQueue(const size_t _capacity = 16)
+		{
+			size_t c = 1;
+			while(c < _capacity)
+				c <<= 1;
+			m_data.resize(c);
+		}
+
+		bool empty() const { return m_size == 0; }
+		size_t size() const { return m_size; }
+
+		void push_back(const T& _v)
+		{
+			if(m_size == m_data.size())
+				grow();
+			m_data[(m_head + m_size) & mask()] = _v;
+			++m_size;
+		}
+
+		const T& front() const
+		{
+			assert(m_size);
+			return m_data[m_head];
+		}
+
+		void pop_front()
+		{
+			assert(m_size);
+			m_head = (m_head + 1) & mask();
+			--m_size;
+		}
+
+		void clear()
+		{
+			m_head = 0;
+			m_size = 0;
+		}
+
+		// Element _i counted from the front.
+		const T& operator[](const size_t _i) const { return m_data[(m_head + _i) & mask()]; }
+
+		// Removes element _i counted from the front, keeping the order of the others.
+		void erase(const size_t _i)
+		{
+			assert(_i < m_size);
+			for(size_t k = _i; k + 1 < m_size; ++k)
+				m_data[(m_head + k) & mask()] = m_data[(m_head + k + 1) & mask()];
+			--m_size;
+		}
+
+	private:
+		size_t mask() const { return m_data.size() - 1; }
+
+		void grow()
+		{
+			std::vector<T> data(m_data.size() * 2);
+			for(size_t i = 0; i < m_size; ++i)
+				data[i] = (*this)[i];
+			m_data.swap(data);
+			m_head = 0;
+		}
+
+		std::vector<T> m_data;
+		size_t m_head = 0;
+		size_t m_size = 0;
+	};
+}
diff --git a/test/ring_queue_test.cpp b/test/ring_queue_test.cpp
new file mode 100644
index 0000000..8192ef2
--- /dev/null
+++ b/test/ring_queue_test.cpp
@@ -0,0 +1,80 @@
+#include "ringQueue.h"
+
+#include <cstdint>
+#include <deque>
+#include <iostream>
+#include <random>
+
+// RingQueue replaces std::deque for the HDI08 receive and interrupt queues, so it must behave as
+// one for every operation those use: FIFO order across wrap-around and growth, size, clear,
+// indexed reads from the front, and erase in the middle. Checked against std::deque on a long
+// random sequence that starts small (capacity 4), so growth from a wrapped state is exercised.
+int main()
+{
+	mc68k::RingQueue<uint32_t> ring(4);
+	std::deque<uint32_t> ref;
+	std::mt19937 rng(12345);
+	uint32_t next = 0;
+	int failures = 0;
+
+	auto fail = [&](const char* _what, const size_t _step)
+	{
+		if(failures++ < 10)
+			std::cerr << "ring_queue_test: " << _what << " at step " << _step << '\n';
+	};
+
+	for(size_t step = 0; step < 200000; ++step)
+	{
+		const auto op = rng() % 100;
+		// Bias depth upwards over time, then back down, so the ring grows several times.
+		const bool pushBias = (step / 20000) % 2 == 0;
+		if(op < (pushBias ? 55u : 40u))
+		{
+			ring.push_back(next);
+			ref.push_back(next);
+			++next;
+		}
+		else if(op < 95)
+		{
+			if(!ref.empty())
+			{
+				if(ring.front() != ref.front())
+					fail("front", step);
+				ring.pop_front();
+				ref.pop_front();
+			}
+		}
+		else if(op < 99)
+		{
+			if(!ref.empty())
+			{
+				const size_t i = rng() % ref.size();
+				ring.erase(i);
+				ref.erase(ref.begin() + static_cast<std::ptrdiff_t>(i));
+			}
+		}
+		else if(rng() % 50 == 0)
+		{
+			ring.clear();
+			ref.clear();
+		}
+
+		if(ring.size() != ref.size() || ring.empty() != ref.empty())
+			fail("size", step);
+		if(step % 997 == 0)
+			for(size_t i = 0; i < ref.size(); ++i)
+				if(ring[i] != ref[i])
+				{
+					fail("element", step);
+					break;
+				}
+	}
+
+	if(failures)
+	{
+		std::cerr << "ring_queue_test: " << failures << " failures\n";
+		return 1;
+	}
+	std::cout << "ring_queue_test: ok\n";
+	return 0;
+}
