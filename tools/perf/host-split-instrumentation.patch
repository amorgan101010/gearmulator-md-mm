+		}
+	} g_hostSplitDump;
+	struct TscAcc
+	{
+		// Exclusive time: nested accumulators (inline catch-ups) are subtracted from the parent.
+		static inline TscAcc* s_top = nullptr;
+		uint64_t* p; uint64_t* p2; uint64_t s; uint64_t child = 0; TscAcc* parent;
+		explicit TscAcc(uint64_t* _p, uint64_t* _p2 = nullptr, uint64_t* _c = nullptr) : p(_p), p2(_p2), s(__rdtsc()), parent(s_top) { if(_c) ++*_c; s_top = this; }
+		~TscAcc()
+		{
+			const auto tot = __rdtsc() - s;
+			const auto d = tot - child;
+			*p += d; if(p2) *p2 += d;
+			if(parent) { parent->child += tot; ++g_nested; }
+			s_top = parent;
+		}
+	};
+}
